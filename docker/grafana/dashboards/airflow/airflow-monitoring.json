      "pluginVersion": "10.0.3",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_AIRFLOW-DB}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  ti.task_id,\n  dr.dag_id,\n  ti.state,\n  ti.start_date,\n  ti.end_date,\n  ti.duration\nFROM task_instance ti\nJOIN dag_run dr ON ti.dag_id = dr.dag_id AND ti.run_id = dr.run_id\nWHERE ti.start_date > NOW() - INTERVAL '1 day'\nORDER BY ti.start_date DESC\nLIMIT 100;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Recent Task Executions",
      "type": "table"
    },
