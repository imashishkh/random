            "uid": "${DS_AIRFLOW-DB}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  ti.start_date as time,\n  ti.duration as value,\n  ti.task_id as metric\nFROM task_instance ti\nWHERE \n  ti.state = 'success' AND\n  ti.start_date > NOW() - INTERVAL '3 days' AND\n  ti.duration IS NOT NULL\nORDER BY ti.start_date;",
          "refId": "A",
          "sql": {
